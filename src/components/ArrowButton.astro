---
type ArrowButtonDirection = 'prev' | 'next';

type Props = {
	direction: ArrowButtonDirection;
	label?: string;
	ariaLabel?: string;
	class?: string;
	type?: 'button' | 'submit' | 'reset';
	[key: string]: unknown;
};

const { direction, label, ariaLabel, class: className, type = 'button', ...attrs } = Astro.props as Props;
const buttonClass = ['arrow-button', `arrow-button-${direction}`, className].filter(Boolean).join(' ');
const accessibleLabel = label ?? ariaLabel;
---

<button {...attrs} class={buttonClass} type={type} data-arrow-direction={direction}>
	<span class="arrow-button-icon" aria-hidden="true"></span>
	{accessibleLabel && <span class="visually-hidden">{accessibleLabel}</span>}
</button>
