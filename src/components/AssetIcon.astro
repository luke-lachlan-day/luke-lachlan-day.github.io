---
import { iconSvgBySrc } from './icons/iconSvgBySrc';

interface Props {
	src: string;
	class?: string;
}

const { src, class: className } = Astro.props;
const iconSvg = iconSvgBySrc[src];
---

<span class:list={['asset-icon', className]} aria-hidden="true">
	{iconSvg ? <Fragment set:html={iconSvg} /> : <img src={src} alt="" loading="lazy" />}
</span>
