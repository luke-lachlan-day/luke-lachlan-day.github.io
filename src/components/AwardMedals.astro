---
import type { ImageAsset } from '../data/profile';
import { getImageAttrs } from '../utils/images';

type AwardMedal = {
	name: string;
	awardedFrom: string;
	detail?: string;
	year: string;
	emblem: ImageAsset;
};

type Props = {
	awards: AwardMedal[];
	ariaLabel: string;
	class?: string;
};

const { awards, ariaLabel, class: className } = Astro.props;
const medalBaseSrc = '/assets/emblems/award-medal-base.webp';
---

{
	awards.length > 0 && (
		<div
			class:list={['project-awards', 'project-awards-medal-rack', className]}
			data-awards-initializing="true"
			role="group"
			aria-label={ariaLabel}
		>
			<div class="project-award-list">
				{awards.map((award) => {
					const itemLabel = award.detail
						? `${award.year} ${award.name}, ${award.detail}, ${award.awardedFrom}`
						: `${award.year} ${award.name}, awarded by ${award.awardedFrom}`;
					const detailLines = award.detail ? [award.detail, award.awardedFrom] : [award.awardedFrom];

					return (
						<span class="project-award" role="img" tabindex="0" aria-label={itemLabel}>
							<img class="project-award-medal-base" src={medalBaseSrc} alt="" loading="lazy" {...getImageAttrs(medalBaseSrc)} aria-hidden="true" />
							<img
								class="project-award-emblem"
								src={award.emblem.src}
								alt=""
								loading="lazy"
								{...getImageAttrs(award.emblem)}
								aria-hidden="true"
							/>
							<span class="project-award-details" aria-hidden="true">
								<strong>{award.name}</strong>
								{detailLines.map((line) => (
									<span>{line}</span>
								))}
								<small>{award.year}</small>
							</span>
						</span>
					);
				})}
			</div>
		</div>
	)
}

{
	awards.length > 0 && (
		<script is:inline>
			(() => {
				const enableAwardInteractions = () => {
					document.querySelectorAll('[data-awards-initializing]').forEach((rack) => {
						rack.removeAttribute('data-awards-initializing');
					});
				};

				if (!('requestAnimationFrame' in window)) {
					window.setTimeout(enableAwardInteractions, 0);
					return;
				}

				window.requestAnimationFrame(() => {
					window.requestAnimationFrame(enableAwardInteractions);
				});
			})();
		</script>
	)
}
