---
import AssetIcon from './AssetIcon.astro';
import { getExternalLinkAttrs } from '../utils/links';

type ButtonVariant = 'primary' | 'secondary';

type Props = {
	href: string;
	label: string;
	icon?: string;
	variant?: ButtonVariant;
	class?: string;
};

const { href, label, icon, variant = 'primary', class: className } = Astro.props as Props;
const externalAttrs = getExternalLinkAttrs(href);
---

<a class:list={['button', variant === 'secondary' && 'button-2', className]} href={href} {...externalAttrs}>
	{icon && <AssetIcon src={icon} class="button-icon" />}
	{label}
</a>
