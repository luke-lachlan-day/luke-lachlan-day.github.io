---
import AssetIcon from './AssetIcon.astro';
import { getExternalLinkAttrs } from '../utils/links';

type ButtonVariant = 'primary' | 'secondary';

type Props = {
	href: string;
	label: string;
	icon?: string;
	variant?: ButtonVariant;
	class?: string;
	target?: string;
	rel?: string;
};

const {
	href,
	label,
	icon,
	variant = 'primary',
	class: className,
	target,
	rel,
} = Astro.props as Props;
const externalAttrs = getExternalLinkAttrs(href);
const linkTarget = target ?? externalAttrs.target;
const linkRel = rel ?? externalAttrs.rel;
---

<a
	class:list={['button', variant === 'secondary' && 'button-2', className]}
	href={href}
	target={linkTarget}
	rel={linkRel}
>
	{icon && <AssetIcon src={icon} class="button-icon" />}
	{label}
</a>
