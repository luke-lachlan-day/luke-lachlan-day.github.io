---
import type { ImageAsset } from '../data/types';
import { getImageAttrs } from '../utils/images';

type Props = {
	icon?: ImageAsset;
	label?: string;
	class?: string;
};

const { icon, label, class: className } = Astro.props as Props;
const badgeClass = ['project-wheel-company-badge', className].filter(Boolean).join(' ');
---

{
	(icon || label) && (
		<span class={badgeClass} aria-hidden="true">
			<span class="project-wheel-company-badge-back" />
			{icon ? (
				<img class="project-wheel-company-badge-icon" src={icon.src} alt="" loading="lazy" {...getImageAttrs(icon)} />
			) : (
				<span class="project-wheel-company-badge-label">{label}</span>
			)}
		</span>
	)
}
