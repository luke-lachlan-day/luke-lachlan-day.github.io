---
import type { FallingLeavesEffect } from '../data/profile';

interface Props {
	config: FallingLeavesEffect;
}

const { config } = Astro.props;
const leafAmount = Math.max(0, Math.floor(config.goalAmount));
---

{
	config.enabled && leafAmount > 0 && (
		<div
			class="falling-leaves"
			aria-hidden="true"
			data-falling-leaves
			data-leaf-count={leafAmount}
		>
			<div class="falling-leaves-layer falling-leaves-layer-back" data-leaf-layer="back" />
			<div class="falling-leaves-layer falling-leaves-layer-mid" data-leaf-layer="mid" />
			<div class="falling-leaves-layer falling-leaves-layer-front" data-leaf-layer="front" />
		</div>
	)
}

<script is:inline>
	(() => {
		const root = document.querySelector('[data-falling-leaves]');
		if (!root) return;

		const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
		if (motionQuery.matches) {
			root.setAttribute('hidden', '');
			return;
		}

		const leafCount = Number.parseInt(root.dataset.leafCount ?? '0', 10);
		const layerSettings = [
			{
				name: 'back',
				share: 0.36,
				minSize: 28,
				maxSize: 40,
				duration: [24, 34],
				sway: [26, 48],
				scrollDepth: 0.1,
				windDepth: 0.35,
			},
			{
				name: 'mid',
				share: 0.42,
				minSize: 40,
				maxSize: 56,
				duration: [18, 27],
				sway: [34, 66],
				scrollDepth: 0.25,
				windDepth: 0.68,
			},
			{
				name: 'front',
				share: 0.22,
				minSize: 58,
				maxSize: 82,
				duration: [14, 21],
				sway: [48, 88],
				scrollDepth: 0.45,
				windDepth: 1,
			},
		];

		const random = (min, max) => min + Math.random() * (max - min);
		const getPageHeight = () =>
			Math.max(
				document.documentElement.scrollHeight,
				document.body.scrollHeight,
				window.innerHeight || 0
			);

		const layers = layerSettings.map((settings, index) => ({
			...settings,
			element: root.querySelector(`[data-leaf-layer="${settings.name}"]`),
			count:
				index === layerSettings.length - 1
					? 0
					: Math.round(leafCount * settings.share),
		}));

		const assignedCount = layers.reduce((sum, layer) => sum + layer.count, 0);
		layers[layers.length - 1].count = Math.max(0, leafCount - assignedCount);
		const leaves = [];

		layers.forEach((layer) => {
			if (!layer.element) return;
			layer.element.style.setProperty('--leaf-wind-depth', layer.windDepth.toFixed(2));

			for (let index = 0; index < layer.count; index += 1) {
				const leaf = document.createElement('span');
				leaf.className = 'falling-leaf';
				leaf.style.setProperty('--leaf-x', `${random(-8, 102).toFixed(2)}vw`);
				leaf.style.setProperty('--leaf-size', `${random(layer.minSize, layer.maxSize).toFixed(2)}px`);
				leaf.style.setProperty('--leaf-duration', `${random(layer.duration[0], layer.duration[1]).toFixed(2)}s`);
				leaf.style.setProperty('--leaf-delay', `${random(-layer.duration[1], -1).toFixed(2)}s`);
				leaf.style.setProperty('--leaf-sway', `${random(layer.sway[0], layer.sway[1]).toFixed(2)}px`);
				leaf.style.setProperty('--leaf-drift', `${random(-22, 22).toFixed(2)}px`);
				leaf.style.setProperty('--leaf-spin', `${random(220, 620).toFixed(2)}deg`);
				leaf.style.setProperty('--leaf-start-rotation', `${random(0, 360).toFixed(2)}deg`);
				leaf.style.setProperty('--leaf-tilt', `${random(-34, 34).toFixed(2)}deg`);
				leaf.style.setProperty('--leaf-fall-distance', `${random(92, 136).toFixed(2)}vh`);
				layer.element.append(leaf);
				leaves.push({ element: leaf, yRatio: Math.random() });
			}
		});

		let scrollY = window.scrollY;
		let frame = 0;
		let pageHeight = getPageHeight();

		const updateLeafPositions = () => {
			const viewportHeight = window.innerHeight || 1;
			pageHeight = getPageHeight();
			root.style.setProperty('--leaf-page-height', `${pageHeight + viewportHeight}px`);

			leaves.forEach((leaf) => {
				const y = leaf.yRatio * (pageHeight + viewportHeight * 2) - viewportHeight;
				leaf.element.style.setProperty('--leaf-y', `${y.toFixed(2)}px`);
			});
		};

		const updateParallax = () => {
			frame = 0;

			layers.forEach((layer) => {
				if (!layer.element) return;
				const y = scrollY * -layer.scrollDepth;
				layer.element.style.setProperty('--leaf-parallax-y', `${y.toFixed(2)}px`);
			});
		};

		const requestUpdate = () => {
			if (!frame) frame = window.requestAnimationFrame(updateParallax);
		};

		window.addEventListener(
			'scroll',
			() => {
				scrollY = window.scrollY;
				requestUpdate();
			},
			{ passive: true }
		);

		window.addEventListener(
			'resize',
			() => {
				updateLeafPositions();
				scrollY = window.scrollY;
				requestUpdate();
			},
			{ passive: true }
		);

		window.addEventListener(
			'load',
			() => {
				updateLeafPositions();
				scrollY = window.scrollY;
				requestUpdate();
			},
			{ once: true }
		);

		updateLeafPositions();
		updateParallax();
	})();
</script>
