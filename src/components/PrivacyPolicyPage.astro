---
import type { PrivacyPolicy } from '../data/types';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getExternalLinkAttrs } from '../utils/links';
import '../styles/pages/privacy.css';

interface Props {
	policy: PrivacyPolicy;
}

const { policy } = Astro.props;
---

<BaseLayout title={policy.title} description={policy.description}>
	<article class="privacy-policy" aria-labelledby="privacy-title">
		<header class="privacy-policy-header">
			<h1 id="privacy-title">{policy.title}</h1>
			<p class="privacy-policy-updated">
				Last updated: <time datetime={policy.updatedDate}>{policy.updatedLabel}</time>
			</p>
			<p>{policy.introduction}</p>
		</header>
		{
			policy.sections.map((section) => (
				<section class="privacy-policy-section">
					<h2>{section.heading}</h2>
					<p>
						{section.content.map((part) =>
							typeof part === 'string' ? (
								part
							) : (
								<a href={part.href} {...getExternalLinkAttrs(part.href)} set:text={part.label} />
							)
						)}
					</p>
				</section>
			))
		}
	</article>
</BaseLayout>
