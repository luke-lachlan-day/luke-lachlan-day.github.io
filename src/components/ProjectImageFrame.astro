---
import type { HTMLAttributes } from 'astro/types';
import { getImageAttrs, type ImageDecoding } from '../utils/images';

type FrameAttrs = Omit<HTMLAttributes<'span'>, 'class' | 'style'>;

type Props = FrameAttrs & {
	src: string;
	alt: string;
	loading?: 'eager' | 'lazy';
	width?: number;
	height?: number;
	decoding?: ImageDecoding;
	class?: string;
	imageClass?: string;
	style?: string;
};

const {
	src,
	alt,
	loading = 'lazy',
	width,
	height,
	decoding,
	class: className,
	imageClass,
	style: styleValue,
	...attrs
} = Astro.props as Props;
const frameClass = ['project-image-frame', className].filter(Boolean).join(' ');
const foregroundClass = ['project-image-frame-img', imageClass].filter(Boolean).join(' ');
const frameStyle = styleValue || undefined;
const fallbackImageAttrs = getImageAttrs(src, decoding ?? 'async');
const imageAttrs = {
	...fallbackImageAttrs,
	width: width ?? fallbackImageAttrs.width,
	height: height ?? fallbackImageAttrs.height,
};
---

<span {...attrs} class={frameClass} style={frameStyle}>
	<img class="project-image-frame-backdrop" src={src} alt="" loading={loading} {...imageAttrs} aria-hidden="true" />
	<img class={foregroundClass} src={src} alt={alt} loading={loading} {...imageAttrs} />
	<slot />
</span>
