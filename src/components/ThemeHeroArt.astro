---
import type { ImageAsset } from '../data/types';

type Props = {
	light: ImageAsset;
	dark: ImageAsset;
	class?: string;
	imageClass?: string;
	ariaLabel?: string;
	decorative?: boolean;
};

const { light, dark, class: className, imageClass = '', ariaLabel, decorative = true } = Astro.props as Props;

const wrapperAttrs = decorative ? { 'aria-hidden': true } : { role: 'img' as const, 'aria-label': ariaLabel ?? light.alt };
const assetClass = (theme: 'light' | 'dark') => ['theme-asset', `theme-asset-${theme}`, imageClass].filter(Boolean).join(' ');
const assetStyle = [
	`--theme-asset-light-image: url(${JSON.stringify(light.src)})`,
	`--theme-asset-dark-image: url(${JSON.stringify(dark.src)})`,
]
	.filter(Boolean)
	.join('; ');
---

<div class={className} style={assetStyle} {...wrapperAttrs}>
	<span class={assetClass('light')} aria-hidden="true"></span>
	<span class={assetClass('dark')} aria-hidden="true"></span>
</div>
