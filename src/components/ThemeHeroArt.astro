---
import type { ImageAsset } from '../data/profile';
import { getImageAttrs } from '../utils/images';

type Props = {
	light: ImageAsset;
	dark: ImageAsset;
	class?: string;
	imageClass?: string;
	ariaLabel?: string;
	width?: string | number;
	height?: string | number;
	decorative?: boolean;
};

const {
	light,
	dark,
	class: className,
	imageClass = '',
	ariaLabel,
	width,
	height,
	decorative = true,
} = Astro.props as Props;

const wrapperAttrs = decorative
	? { 'aria-hidden': 'true' }
	: { role: 'img', 'aria-label': ariaLabel ?? light.alt };
const getAssetClassName = (themeClass: string) =>
	['theme-asset', imageClass, themeClass].filter(Boolean).join(' ');
const lightFallbackAttrs = getImageAttrs(light);
const darkFallbackAttrs = getImageAttrs(dark);
const lightImageAttrs = {
	...lightFallbackAttrs,
	width: width ?? lightFallbackAttrs.width,
	height: height ?? lightFallbackAttrs.height,
};
const darkImageAttrs = {
	...darkFallbackAttrs,
	width: width ?? darkFallbackAttrs.width,
	height: height ?? darkFallbackAttrs.height,
};
---

<div class={className} {...wrapperAttrs}>
	<img
		class={getAssetClassName('theme-asset-light')}
		src={light.src}
		alt=""
		{...lightImageAttrs}
		aria-hidden="true"
	/>
	<img
		class={getAssetClassName('theme-asset-dark')}
		src={dark.src}
		alt=""
		{...darkImageAttrs}
		aria-hidden="true"
	/>
</div>
