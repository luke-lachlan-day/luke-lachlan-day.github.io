---
import type { ImageAsset } from '../data/profile';

type Props = {
	light: ImageAsset;
	dark: ImageAsset;
	class?: string;
	imageClass?: string;
	ariaLabel?: string;
	width?: string | number;
	height?: string | number;
	decorative?: boolean;
};

const {
	light,
	dark,
	class: className,
	imageClass = '',
	ariaLabel,
	width,
	height,
	decorative = true,
} = Astro.props as Props;

const wrapperAttrs = decorative
	? { 'aria-hidden': 'true' }
	: { role: 'img', 'aria-label': ariaLabel ?? light.alt };
const getAssetClassName = (themeClass: string) =>
	['theme-asset', imageClass, themeClass].filter(Boolean).join(' ');
---

<div class={className} {...wrapperAttrs}>
	<img
		class={getAssetClassName('theme-asset-light')}
		src={light.src}
		alt=""
		width={width}
		height={height}
		aria-hidden="true"
	/>
	<img
		class={getAssetClassName('theme-asset-dark')}
		src={dark.src}
		alt=""
		width={width}
		height={height}
		aria-hidden="true"
	/>
</div>
