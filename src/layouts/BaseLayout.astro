---
import '../styles/global.css';
import FallingLeaves from '../components/FallingLeaves.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHead from '../components/layout/SiteHead.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import { profile } from '../data/profile';

interface Props {
	title?: string;
	description?: string;
	socialImage?: string;
}

const {
	title = 'Luke Lachlan Day',
	description = 'Personal website for Luke Lachlan Day.',
	socialImage = '/assets/images/project-luke-lachlan-day-website.webp',
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).toString();
const socialImageUrl = new URL(socialImage, Astro.url.origin).toString();
---

<!doctype html>
<html lang="en">
	<SiteHead
		title={title}
		description={description}
		canonicalUrl={canonicalUrl}
		socialImageUrl={socialImageUrl}
		generator={Astro.generator}
	/>
	<body>
		<FallingLeaves config={profile.effects.fallingLeaves} />

		<SiteHeader currentPath={currentPath} />

		<main>
			<slot />
		</main>

		<SiteFooter />

		<script>
			import { setupSitePreferences } from '../scripts/sitePreferences';

			setupSitePreferences();
		</script>
	</body>
</html>
