---
import BaseLayout from '../layouts/BaseLayout.astro';
import AssetIcon from '../components/AssetIcon.astro';
import { profile } from '../data/profile';

const { contact } = profile;
---

<BaseLayout
	title={contact.title}
	description={contact.description}
>
	<section class="page-hero" aria-labelledby="contact-title">
		<h1 id="contact-title">{contact.hero.title}</h1>
		<p>{contact.hero.lead}</p>
	</section>

	<section class="section" aria-labelledby="contact-links-title">
		<div class="section-heading">
			<p class="eyebrow">{contact.channels.eyebrow}</p>
			<h2 id="contact-links-title">{contact.channels.title}</h2>
		</div>

		<div class="contact-grid">
			{
				contact.links.map((link) => (
					<article class="contact-card">
						<div class="contact-card-header">
							<AssetIcon src={link.icon} class="contact-card-icon" />
							<p class="meta-label">{link.label}</p>
						</div>
						<h3>{link.display}</h3>
						<p>{link.copy}</p>
						<a href={link.href}>{link.display}</a>
					</article>
				))
			}
		</div>
	</section>
</BaseLayout>
