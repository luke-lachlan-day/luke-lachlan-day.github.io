---
import BaseLayout from '../layouts/BaseLayout.astro';
import AssetIcon from '../components/AssetIcon.astro';
import { profile } from '../data/profile';

const { contact } = profile;
const isExternalLink = (href: string) => href.startsWith('http://') || href.startsWith('https://');
---

<BaseLayout
	title={contact.title}
	description={contact.description}
>
	<section class="contact-hero" aria-labelledby="contact-title">
		<div class="contact-hero-content">
			<h1 id="contact-title" class="hero-title">{contact.hero.title}</h1>
			<p class="hero-role">{contact.hero.subtitle}</p>
			<p class="hero-intro">
				{contact.hero.summary.map((summaryLine) => <span class="hero-intro-line">{summaryLine}</span>)}
			</p>
		</div>

		<div class="contact-hero-art" role="img" aria-label={contact.heroImages.light.alt}>
			<img
				class="contact-hero-image theme-asset-light"
				src={contact.heroImages.light.src}
				alt=""
				width="1390"
				height="1132"
				aria-hidden="true"
			/>
			<img
				class="contact-hero-image theme-asset-dark"
				src={contact.heroImages.dark.src}
				alt=""
				width="1390"
				height="1132"
				aria-hidden="true"
			/>
		</div>
	</section>

	<section class="section contact-section" aria-label="Contact links">
		<div class="contact-grid">
			{
				contact.links.map((link) => (
					<a
						class="contact-card"
						href={link.href}
						target={isExternalLink(link.href) ? '_blank' : undefined}
						rel={isExternalLink(link.href) ? 'noreferrer' : undefined}
						aria-label={`Open ${link.label}`}
					>
						<div class="contact-card-header">
							<AssetIcon src={link.icon} class="contact-card-icon" />
							<p class="meta-label">{link.label}</p>
						</div>
						<p class="contact-card-link">{link.display}</p>
					</a>
				))
			}
		</div>
	</section>
</BaseLayout>
