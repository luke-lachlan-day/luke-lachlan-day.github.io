---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/contact.css';
import HeroContent from '../components/HeroContent.astro';
import ThemeHeroArt from '../components/ThemeHeroArt.astro';
import { profile } from '../data/profile';
import { getImageAttrs } from '../utils/images';
import { getExternalLinkAttrs } from '../utils/links';

const { contact } = profile;
---

<BaseLayout title={contact.title} description={contact.description}>
	<section class="contact-hero" aria-labelledby="contact-title">
		<HeroContent
			class="contact-hero-content"
			title={contact.hero.title}
			titleId="contact-title"
			subtitle={contact.hero.subtitle}
			summary={contact.hero.summary}
		/>

		<ThemeHeroArt
			class="contact-hero-art"
			imageClass="contact-hero-image"
			light={contact.heroImages.light}
			dark={contact.heroImages.dark}
			width="1390"
			height="1132"
			decorative={false}
			ariaLabel={contact.heroImages.light.alt}
		/>
	</section>

	<section class="section contact-section" aria-labelledby="contact-links-title">
		<h2 id="contact-links-title" class="visually-hidden">Contact links</h2>
		<div class="contact-grid">
			{
				contact.links.map((link) => (
					<a class="contact-card" href={link.href} {...getExternalLinkAttrs(link.href)}>
						<img
							class="contact-card-icon"
							src={link.contactIcon ?? link.icon}
							alt=""
							{...getImageAttrs(link.contactIcon ?? link.icon)}
							loading="lazy"
						/>
						<h2 class="contact-card-title">{link.label}</h2>
						{link.description && <p class="contact-card-description">{link.description}</p>}
						<p class="contact-card-link">{link.display}</p>
					</a>
				))
			}
		</div>
	</section>
</BaseLayout>
