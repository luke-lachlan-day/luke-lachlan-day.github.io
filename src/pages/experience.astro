---
import BaseLayout from '../layouts/BaseLayout.astro';
import AwardMedals from '../components/AwardMedals.astro';
import PortfolioWheelCard from '../components/PortfolioWheelCard.astro';
import ProjectImageFrame from '../components/ProjectImageFrame.astro';
import { profile, type ExperienceItem } from '../data/profile';
import { getInitialWheelSlot } from '../utils/wheelSlots';

const { experience, companies } = profile;
const companyById = new Map(companies.map((company) => [company.id, company]));
const wheelExperience = [...experience.items].sort((itemA, itemB) => itemB.sortDate.localeCompare(itemA.sortDate));
const initialActiveExperienceIndex = 0;
const initialTransitionSlotRange = 3;
const getCompanyIcon = (item: ExperienceItem) => (item.companyId ? companyById.get(item.companyId)?.icon : undefined);
const getExperiencePictures = (item: ExperienceItem) => item.pictures ?? [];
const getExperienceMedia = (item: ExperienceItem) => getExperiencePictures(item)[0] ?? getCompanyIcon(item);
---

<BaseLayout
	title={experience.title}
	description={experience.description}
>
	<section class="page-hero projects-hero" aria-labelledby="experience-title">
		<h1 id="experience-title">{experience.hero.title}</h1>
		{experience.hero.lead && <p>{experience.hero.lead}</p>}
	</section>

	<section class="section project-showcase experience-showcase" id="experience-showcase" aria-label="Experience selector">
		<div
			class="project-wheel experience-wheel"
			data-experience-wheel
			data-wheel-controller
			data-wheel-card-selector="[data-experience-card]"
			data-wheel-detail-selector="[data-experience-detail-item]"
			data-wheel-index-attr="data-experience-index"
			data-wheel-id-attr="data-experience-id"
			data-wheel-change-event="experience-detail-change"
			data-wheel-initializing="true"
			data-active-index={initialActiveExperienceIndex}
			role="group"
			aria-label="Experience selector"
		>
			<button class="project-wheel-nav project-wheel-nav-prev" type="button" data-wheel-prev aria-label="Previous experience">
				<span aria-hidden="true">&lsaquo;</span>
			</button>

			<div class="project-wheel-viewport">
				{
					wheelExperience.map((item, index) => {
						const icon = getCompanyIcon(item);
						const media = getExperienceMedia(item);
						const isActive = index === initialActiveExperienceIndex;
						const initialSlot = getInitialWheelSlot(index, wheelExperience.length, initialActiveExperienceIndex, initialTransitionSlotRange);

						return (
							<PortfolioWheelCard
								class="experience-wheel-card"
								title={item.cardRole ?? item.role}
								subtitle={item.dateLabel}
								media={media}
								mediaDecorative={true}
								badge={icon ? { icon } : { label: item.company.slice(0, 1) }}
								ariaLabel={`Select ${item.role} at ${item.company}`}
								isActive={isActive}
								initialSlot={initialSlot}
								fallbackClass="experience-wheel-media-fallback"
								fallbackLabel={item.company.slice(0, 1)}
								dataAttrs={{
									'data-experience-card': '',
									'data-experience-index': index,
									'data-experience-id': item.id,
								}}
							/>
						);
					})
				}
			</div>

			<button class="project-wheel-nav project-wheel-nav-next" type="button" data-wheel-next aria-label="Next experience">
				<span aria-hidden="true">&rsaquo;</span>
			</button>
		</div>

		<img class="project-wheel-chest experience-wheel-book" src="/assets/images/experience-book.webp" alt="" loading="lazy" aria-hidden="true" />

		<div class="project-detail-panel experience-detail-panel" data-experience-detail aria-live="polite">
			{
				wheelExperience.map((item, index) => {
					const icon = getCompanyIcon(item);
					const pictures = getExperiencePictures(item);
					const hasMultiplePictures = pictures.length > 1;

					return (
						<article
							class="project-detail experience-detail"
							id={`experience-detail-${item.id}`}
							data-experience-detail-item
							data-experience-index={index}
							hidden={index === initialActiveExperienceIndex ? undefined : true}
						>
							<AwardMedals
								awards={item.recognition ?? []}
								ariaLabel={`${item.role} recognition`}
								class="experience-recognition-compact"
							/>
							<div class="project-detail-media experience-detail-media">
								{
									pictures.length > 0 ? (
										<div
											class="project-detail-gallery"
											data-experience-gallery
											data-gallery-index="0"
											role="group"
											aria-label={`${item.role} at ${item.company} images`}
										>
											{pictures.map((picture, pictureIndex) => (
												<ProjectImageFrame
													class="project-detail-gallery-image"
													src={picture.src}
													alt={picture.alt}
													loading={index === 0 && pictureIndex === 0 ? 'eager' : 'lazy'}
													data-gallery-image
													data-gallery-image-index={pictureIndex}
													data-gallery-state={pictureIndex === 0 ? 'active' : undefined}
													aria-hidden={pictureIndex === 0 ? 'false' : 'true'}
												/>
											))}
											{hasMultiplePictures && (
												<>
													<button
														class="project-detail-gallery-control project-detail-gallery-control-prev"
														type="button"
														data-gallery-step="-1"
														aria-label={`Show previous ${item.role} image`}
													>
														<span aria-hidden="true">&lsaquo;</span>
													</button>
													<button
														class="project-detail-gallery-control project-detail-gallery-control-next"
														type="button"
														data-gallery-step="1"
														aria-label={`Show next ${item.role} image`}
													>
														<span aria-hidden="true">&rsaquo;</span>
													</button>
													<div class="project-detail-gallery-dots" role="group" aria-label={`${item.role} image selector`}>
														{pictures.map((_, pictureIndex) => (
															<button
																class="project-detail-gallery-dot"
																type="button"
																data-gallery-dot
																data-gallery-dot-index={pictureIndex}
																aria-label={`Show ${item.role} image ${pictureIndex + 1} of ${pictures.length}`}
																aria-current={pictureIndex === 0 ? 'true' : undefined}
															></button>
														))}
													</div>
												</>
											)}
										</div>
									) : icon ? (
										<ProjectImageFrame class="project-detail-gallery" src={icon.src} alt={icon.alt} loading={index === 0 ? 'eager' : 'lazy'} />
									) : (
										<div class="experience-detail-media-fallback" aria-hidden="true">
											<span class="experience-media-fallback-initial">{item.company.slice(0, 1)}</span>
										</div>
									)
								}
							</div>

							<div class="project-detail-content experience-detail-content">
								<h3>{item.role}</h3>
								<div class="project-detail-meta">
									<span class="project-detail-company">
										{icon && <img src={icon.src} alt="" loading="lazy" />}
										<span>{item.company}</span>
									</span>
									<span>{item.dateLabel}</span>
								</div>
								<p class="project-detail-description">{item.summary}</p>
								<div class="experience-highlights" aria-label={`${item.role} highlights`}>
									<p class="experience-highlights-title">Highlights</p>
									<ul>
										{item.highlights.map((highlight) => <li>{highlight}</li>)}
									</ul>
								</div>
							</div>
						</article>
					);
				})
			}
		</div>
	</section>

	<script>
		import { setupDetailGalleries } from '../scripts/detailGallery';
		import { setupWheelControllers } from '../scripts/wheelController';

		setupWheelControllers();
		setupDetailGalleries({
			gallerySelector: '[data-experience-gallery]',
			detailChangeEvent: 'experience-detail-change',
		});
	</script>
</BaseLayout>
