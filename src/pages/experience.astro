---
import BaseLayout from '../layouts/BaseLayout.astro';
import AwardMedals from '../components/AwardMedals.astro';
import PortfolioWheelCard from '../components/PortfolioWheelCard.astro';
import ProjectImageFrame from '../components/ProjectImageFrame.astro';
import { profile, type ExperienceItem } from '../data/profile';

const { experience, companies } = profile;
const companyById = new Map(companies.map((company) => [company.id, company]));
const wheelExperience = [...experience.items].sort((itemA, itemB) => itemB.sortDate.localeCompare(itemA.sortDate));
const initialActiveExperienceIndex = 0;
const initialTransitionSlotRange = 3;
const getInitialWheelSlot = (index: number) => {
	const total = wheelExperience.length;
	const rawOffset = index - initialActiveExperienceIndex;
	const forwardOffset = rawOffset + total;
	const backwardOffset = rawOffset - total;
	const slot = [rawOffset, forwardOffset, backwardOffset].reduce((best, offset) =>
		Math.abs(offset) < Math.abs(best) ? offset : best
	);

	return Math.abs(slot) <= initialTransitionSlotRange ? String(slot) : undefined;
};
const getCompanyIcon = (item: ExperienceItem) => (item.companyId ? companyById.get(item.companyId)?.icon : undefined);
const getExperienceMedia = (item: ExperienceItem) => item.picture ?? getCompanyIcon(item);
---

<BaseLayout
	title={experience.title}
	description={experience.description}
>
	<section class="page-hero projects-hero" aria-labelledby="experience-title">
		<h1 id="experience-title">{experience.hero.title}</h1>
		{experience.hero.lead && <p>{experience.hero.lead}</p>}
	</section>

	<section class="section project-showcase experience-showcase" id="experience-showcase" aria-label="Experience selector">
		<div
			class="project-wheel experience-wheel"
			data-experience-wheel
			data-wheel-initializing="true"
			data-active-index={initialActiveExperienceIndex}
			role="group"
			aria-label="Experience selector"
		>
			<button class="project-wheel-nav project-wheel-nav-prev" type="button" data-wheel-prev aria-label="Previous experience">
				<span aria-hidden="true">&lsaquo;</span>
			</button>

			<div class="project-wheel-viewport">
				{
					wheelExperience.map((item, index) => {
						const icon = getCompanyIcon(item);
						const media = getExperienceMedia(item);
						const isActive = index === initialActiveExperienceIndex;
						const initialSlot = getInitialWheelSlot(index);

						return (
							<PortfolioWheelCard
								class="experience-wheel-card"
								title={item.cardRole ?? item.role}
								subtitle={item.dateLabel}
								media={media}
								mediaDecorative={true}
								badge={icon ? { icon } : { label: item.company.slice(0, 1) }}
								ariaLabel={`Select ${item.role} at ${item.company}`}
								isActive={isActive}
								initialSlot={initialSlot}
								fallbackClass="experience-wheel-media-fallback"
								fallbackLabel={item.company.slice(0, 1)}
								dataAttrs={{
									'data-experience-card': '',
									'data-experience-index': index,
									'data-experience-id': item.id,
								}}
							/>
						);
					})
				}
			</div>

			<button class="project-wheel-nav project-wheel-nav-next" type="button" data-wheel-next aria-label="Next experience">
				<span aria-hidden="true">&rsaquo;</span>
			</button>
		</div>

		<img class="project-wheel-chest experience-wheel-book" src="/assets/images/experience-book.webp" alt="" loading="lazy" aria-hidden="true" />

		<div class="project-detail-panel experience-detail-panel" data-experience-detail aria-live="polite">
			{
				wheelExperience.map((item, index) => {
					const icon = getCompanyIcon(item);
					const media = getExperienceMedia(item);

					return (
						<article
							class="project-detail experience-detail"
							id={`experience-detail-${item.id}`}
							data-experience-detail-item
							data-experience-index={index}
							hidden={index === initialActiveExperienceIndex ? undefined : true}
						>
							<AwardMedals
								awards={item.recognition ?? []}
								ariaLabel={`${item.role} recognition`}
								class="experience-recognition-compact"
							/>
							<div class="project-detail-media experience-detail-media">
								{
									media ? (
										<ProjectImageFrame class="project-detail-gallery" src={media.src} alt={media.alt} loading={index === 0 ? 'eager' : 'lazy'}>
											{icon && (
												<span class="project-wheel-company-badge experience-detail-company-badge" aria-hidden="true">
													<span class="project-wheel-company-badge-back"></span>
													<span class="project-wheel-company-badge-icon" style={`--company-icon-url: url("${icon.src}")`}></span>
												</span>
											)}
										</ProjectImageFrame>
									) : (
										<div class="experience-detail-media-fallback" aria-hidden="true">
											<span class="experience-media-fallback-initial">{item.company.slice(0, 1)}</span>
										</div>
									)
								}
							</div>

							<div class="project-detail-content experience-detail-content">
								<h3>{item.role}</h3>
								<div class="project-detail-meta">
									<span class="project-detail-company">
										{icon && <img src={icon.src} alt="" loading="lazy" />}
										<span>{item.company}</span>
									</span>
									<span>{item.dateLabel}</span>
								</div>
								<p class="project-detail-description">{item.summary}</p>
								<div class="experience-highlights" aria-label={`${item.role} highlights`}>
									<p class="experience-highlights-title">Highlights</p>
									<ul>
										{item.highlights.map((highlight) => <li>{highlight}</li>)}
									</ul>
								</div>
							</div>
						</article>
					);
				})
			}

			<div class="experience-credentials" aria-label="Selected achievements and background">
				{
					experience.credentials.map((credential) => (
						<div class="experience-credential">
							<strong>{credential.label}</strong>
							<span>{credential.value}</span>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<script is:inline>
		(() => {
			const wheel = document.querySelector('[data-experience-wheel]');
			const cards = Array.from(document.querySelectorAll('[data-experience-card]'));
			const details = Array.from(document.querySelectorAll('[data-experience-detail-item]'));
			const previousButton = document.querySelector('[data-wheel-prev]');
			const nextButton = document.querySelector('[data-wheel-next]');

			if (!wheel || cards.length === 0) {
				return;
			}

			const total = cards.length;
			let activeIndex = Number(wheel.getAttribute('data-active-index')) || 0;
			const desktopQuery = window.matchMedia('(min-width: 821px)');
			const phoneQuery = window.matchMedia('(max-width: 460px)');
			const experienceHashPrefix = '#';

			const getSlotRanges = () => {
				if (phoneQuery.matches) {
					return {
						interactive: 0,
						transition: 1,
					};
				}

				return desktopQuery.matches
					? {
							interactive: 2,
							transition: 3,
						}
					: {
							interactive: 1,
							transition: 2,
						};
			};

			const wrapIndex = (index) => ((index % total) + total) % total;
			const getExperienceIdFromHash = () => {
				const hash = window.location.hash.slice(experienceHashPrefix.length);

				if (!hash) {
					return '';
				}

				try {
					return decodeURIComponent(hash);
				} catch {
					return hash;
				}
			};
			const shortestOffset = (index, active) => {
				const rawOffset = index - active;
				const forwardOffset = rawOffset + total;
				const backwardOffset = rawOffset - total;

				return [rawOffset, forwardOffset, backwardOffset].reduce((best, offset) =>
					Math.abs(offset) < Math.abs(best) ? offset : best
				);
			};

			const updateWheel = () => {
				const { interactive, transition } = getSlotRanges();

				wheel.setAttribute('data-active-index', String(activeIndex));

				cards.forEach((card) => {
					const experienceIndex = Number(card.getAttribute('data-experience-index'));
					const slot = shortestOffset(experienceIndex, activeIndex);
					const slotDistance = Math.abs(slot);
					const transitionSlot = slotDistance <= transition ? String(slot) : '';
					const isInteractive = slotDistance <= interactive;
					const isActive = experienceIndex === activeIndex;

					if (transitionSlot) {
						card.setAttribute('data-slot', transitionSlot);
					} else {
						card.removeAttribute('data-slot');
					}

					card.setAttribute('aria-pressed', String(isActive));
					card.setAttribute('aria-hidden', String(!isInteractive));
					card.tabIndex = isInteractive ? 0 : -1;
				});

				details.forEach((detail) => {
					const experienceIndex = Number(detail.getAttribute('data-experience-index'));
					detail.hidden = experienceIndex !== activeIndex;
				});
			};

			const setActiveIndex = (index, updateHash = false) => {
				activeIndex = wrapIndex(index);
				updateWheel();

				if (!updateHash) {
					return;
				}

				const activeCard = cards[activeIndex];
				const experienceId = activeCard?.getAttribute('data-experience-id');

				if (!experienceId) {
					return;
				}

				const nextHash = `${experienceHashPrefix}${encodeURIComponent(experienceId)}`;
				if (window.location.hash !== nextHash) {
					window.history.replaceState(null, '', nextHash);
				}
			};
			const setActiveExperienceFromHash = () => {
				const experienceId = getExperienceIdFromHash();

				if (!experienceId) {
					return;
				}

				const matchingCard = cards.find((card) => card.getAttribute('data-experience-id') === experienceId);

				if (!matchingCard) {
					return;
				}

				setActiveIndex(Number(matchingCard.getAttribute('data-experience-index')));
			};

			cards.forEach((card) => {
				card.addEventListener('click', () => {
					setActiveIndex(Number(card.getAttribute('data-experience-index')), true);
				});

				card.addEventListener('keydown', (event) => {
					if (event.key === 'ArrowLeft') {
						event.preventDefault();
						setActiveIndex(activeIndex - 1);
					}

					if (event.key === 'ArrowRight') {
						event.preventDefault();
						setActiveIndex(activeIndex + 1);
					}
				});
			});

			previousButton?.addEventListener('click', () => setActiveIndex(activeIndex - 1));
			nextButton?.addEventListener('click', () => setActiveIndex(activeIndex + 1));
			desktopQuery.addEventListener('change', updateWheel);
			phoneQuery.addEventListener('change', updateWheel);
			window.addEventListener('hashchange', setActiveExperienceFromHash);

			setActiveExperienceFromHash();
			updateWheel();

			const enableWheelTransitions = () => {
				wheel.removeAttribute('data-wheel-initializing');
			};

			if (!('requestAnimationFrame' in window)) {
				window.setTimeout(enableWheelTransitions, 0);
				return;
			}

			window.requestAnimationFrame(() => {
				window.requestAnimationFrame(enableWheelTransitions);
			});
		})();
	</script>
</BaseLayout>
