---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/showcase.css';
import DetailGallery from '../components/DetailGallery.astro';
import PortfolioWheelCard from '../components/PortfolioWheelCard.astro';
import ProjectImageFrame from '../components/ProjectImageFrame.astro';
import ShowcaseDetail from '../components/ShowcaseDetail.astro';
import ShowcaseWheel from '../components/ShowcaseWheel.astro';
import { profile, type ExperienceItem } from '../data/profile';
import { getImageAttrs } from '../utils/images';
import { getInitialWheelSlot } from '../utils/wheelSlots';

const { experience, companies } = profile;
const companyById = new Map(companies.map((company) => [company.id, company]));
const wheelExperience = [...experience.items].sort((itemA, itemB) => itemB.sortDate.localeCompare(itemA.sortDate));
const experienceHeroLead = 'lead' in experience.hero ? experience.hero.lead : undefined;
const initialActiveExperienceIndex = 0;
const initialTransitionSlotRange = 3;
const getCompanyIcon = (item: ExperienceItem) => (item.companyId ? companyById.get(item.companyId)?.icon : undefined);
const getExperiencePictures = (item: ExperienceItem) => item.pictures ?? [];
const getExperienceMedia = (item: ExperienceItem) => getExperiencePictures(item)[0] ?? getCompanyIcon(item);
---

<BaseLayout title={experience.title} description={experience.description}>
	<section class="page-hero projects-hero" aria-labelledby="experience-title">
		<h1 id="experience-title">{experience.hero.title}</h1>
		{experienceHeroLead && <p>{experienceHeroLead}</p>}
	</section>

	<section class="section project-showcase experience-showcase" id="experience-showcase" aria-labelledby="experience-selector-title">
		<h2 id="experience-selector-title" class="visually-hidden">Experience selector</h2>
		<ShowcaseWheel
			class="experience-wheel"
			labelledBy="experience-selector-title"
			previousLabel="Previous experience"
			nextLabel="Next experience"
			activeIndex={initialActiveExperienceIndex}
			dataAttrs={{ 'data-experience-wheel': '' }}
		>
			{
				wheelExperience.map((item, index) => {
					const icon = getCompanyIcon(item);
					const media = getExperienceMedia(item);
					const isActive = index === initialActiveExperienceIndex;
					const initialSlot = getInitialWheelSlot(index, wheelExperience.length, initialActiveExperienceIndex, initialTransitionSlotRange);

					return (
						<PortfolioWheelCard
							class="experience-wheel-card"
							title={item.cardRole ?? item.role}
							subtitle={item.cardDateLabel}
							media={media}
							mediaDecorative={true}
							badge={icon ? { icon } : { label: item.company.slice(0, 1) }}
							ariaLabel={`Select ${item.role} at ${item.company}`}
							isActive={isActive}
							initialSlot={initialSlot}
							fallbackClass="experience-wheel-media-fallback"
							fallbackLabel={item.company.slice(0, 1)}
							dataAttrs={{
								'data-experience-card': '',
								'data-experience-index': index,
								'data-experience-id': item.id,
							}}
						/>
					);
				})
			}
		</ShowcaseWheel>

		<img
			class="project-wheel-chest experience-wheel-book"
			src="/assets/images/experience-book.webp"
			alt=""
			loading="lazy"
			{...getImageAttrs('/assets/images/experience-book.webp')}
			aria-hidden="true"
		/>

		<div class="project-detail-panel experience-detail-panel" data-experience-detail aria-live="polite">
			{
				wheelExperience.map((item, index) => {
					const icon = getCompanyIcon(item);
					const pictures = getExperiencePictures(item);

					return (
						<ShowcaseDetail
							id={`experience-detail-${item.id}`}
							index={index}
							activeIndex={initialActiveExperienceIndex}
							itemAttr="data-experience-detail-item"
							indexAttr="data-experience-index"
							awards={item.recognition ?? []}
							awardsAriaLabel={`${item.role} recognition`}
							class="experience-detail"
							awardClass="experience-recognition-compact"
							mediaClass="experience-detail-media"
							contentClass="experience-detail-content"
						>
							<Fragment slot="media">
								{pictures.length > 0 ? (
									<DetailGallery
										pictures={pictures}
										galleryAttr="data-experience-gallery"
										galleryLabel={`${item.role} at ${item.company} images`}
										imageLabel={item.role}
										firstImageEager={index === initialActiveExperienceIndex}
									/>
								) : icon ? (
									<ProjectImageFrame
										class="project-detail-gallery"
										src={icon.src}
										alt={icon.alt}
										loading={index === initialActiveExperienceIndex ? 'eager' : 'lazy'}
									/>
								) : (
									<div class="experience-detail-media-fallback" aria-hidden="true">
										<span class="experience-media-fallback-initial">{item.company.slice(0, 1)}</span>
									</div>
								)}
							</Fragment>

							<Fragment slot="content">
								<h3>{item.role}</h3>
								<div class="project-detail-meta">
									<span class="project-detail-company">
										{icon && <img src={icon.src} alt="" loading="lazy" {...getImageAttrs(icon)} />}
										<span>{item.company}</span>
									</span>
									<span>{item.dateLabel}</span>
								</div>
								<p class="project-detail-description">{item.summary}</p>
								<div class="experience-highlights" aria-label={`${item.role} highlights`}>
									<p class="experience-highlights-title">Highlights</p>
									<ul>
										{item.highlights.map((highlight) => (
											<li>{highlight}</li>
										))}
									</ul>
								</div>
							</Fragment>
						</ShowcaseDetail>
					);
				})
			}
		</div>
	</section>

	<script>
		import { setupDetailGalleries } from '../scripts/detailGallery';
		import { setupWheelControllers } from '../scripts/wheelController';

		setupWheelControllers({
			wheelSelector: '[data-experience-wheel]',
			cardSelector: '[data-experience-card]',
			detailSelector: '[data-experience-detail-item]',
			indexAttr: 'data-experience-index',
			idAttr: 'data-experience-id',
			changeEvent: 'experience-detail-change',
			detailRootSelector: '#experience-showcase',
		});
		setupDetailGalleries({
			gallerySelector: '[data-experience-gallery]',
			detailItemSelector: '[data-experience-detail-item]',
			detailChangeEvent: 'experience-detail-change',
		});
	</script>
</BaseLayout>
