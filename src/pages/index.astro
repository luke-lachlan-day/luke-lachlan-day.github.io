---
import BaseLayout from '../layouts/BaseLayout.astro';
import AssetIcon from '../components/AssetIcon.astro';
import { profile, type Project } from '../data/profile';

const { home, projects, companies } = profile;
const [heroFirstName, ...heroRemainingNames] = profile.name.split(' ');
const heroLastLine = heroRemainingNames.join(' ');
const companyById = new Map(companies.map((company) => [company.id, company]));
const featuredProjects = home.featuredProjectIds
	.map((projectId) => projects.items.find((project) => project.id === projectId))
	.filter((project): project is Project => Boolean(project));
---

<BaseLayout
	title={home.title}
	description={home.description}
>
	<section class="hero" aria-labelledby="home-title">
		<div class="hero-content">
			<h1 id="home-title" class="hero-title" aria-label={profile.name}>
				<span class="hero-title-line">{heroFirstName}</span>
				<span class="hero-title-line hero-title-line-nowrap">{heroLastLine}</span>
			</h1>
			<p class="hero-role">{home.role}</p>
			<p class="hero-intro">
				{home.summary.map((summaryLine) => <span class="hero-intro-line">{summaryLine}</span>)}
			</p>
			<div class="hero-actions">
				{
					home.actions.map((action, index) => (
						<a class={`button button-${index + 1}`} href={action.href}>
							<AssetIcon src={action.icon} class="button-icon" />
							{action.label}
						</a>
					))
				}
			</div>
		</div>

		<div class="hero-art" aria-hidden="true">
			<img class="theme-asset theme-asset-light" src={home.heroImages.light.src} alt="" />
			<img class="theme-asset theme-asset-dark" src={home.heroImages.dark.src} alt="" />
		</div>
	</section>

	<section class="section" aria-labelledby="featured-projects-title">
		<div class="section-heading split">
			<div>
				<h2 id="featured-projects-title">Featured Projects</h2>
			</div>
			<a class="text-link" href="/timeline/">See all projects</a>
		</div>
		<div class="project-grid">
			{
				featuredProjects.map((project) => {
					const company = companyById.get(project.companyId);
					const picture = project.pictures[0];

					return (
						<a
							class="project-card"
							href={projects.href}
							aria-label={`View ${project.product} on the timeline`}
						>
							<img class="project-image" src={picture.src} alt={picture.alt} loading="lazy" />
							<div class="project-body">
								<div class="project-company">
									{company && <img src={company.icon.src} alt="" loading="lazy" />}
									<span>{company?.name}</span>
								</div>
								<h3>{project.product}</h3>
								<p>{project.description}</p>
								<div class="tool-list" aria-label={`${project.product} tools`}>
									{project.tools.map((tool) => <span>{tool}</span>)}
								</div>
							</div>
						</a>
					);
				})
			}
		</div>
	</section>
</BaseLayout>
