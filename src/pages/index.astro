---
import BaseLayout from '../layouts/BaseLayout.astro';
import AwardMedals from '../components/AwardMedals.astro';
import CompanyBadge from '../components/CompanyBadge.astro';
import HeroContent from '../components/HeroContent.astro';
import ProjectImageFrame from '../components/ProjectImageFrame.astro';
import ProjectTagList from '../components/ProjectTagList.astro';
import ThemeHeroArt from '../components/ThemeHeroArt.astro';
import { profile, type Project } from '../data/profile';
import { getProjectTagRenderGroups } from '../data/projectTags';
import { getCompanyLogoToneClass } from '../utils/companyLogoTone';
import { getImageAttrs } from '../utils/images';

const { home, projects, companies } = profile;
const [heroFirstName, ...heroRemainingNames] = profile.name.split(' ');
const heroLastLine = heroRemainingNames.join(' ');
const heroTitleLines = [heroFirstName, heroLastLine];
const companyById = new Map(companies.map((company) => [company.id, company]));
const projectItems: Project[] = [...projects.items];
const featuredProjects = home.featuredProjectIds
	.map((projectId) => projectItems.find((project) => project.id === projectId))
	.filter((project): project is Project => Boolean(project));
---

<BaseLayout title={home.title} description={home.description}>
	<section class="hero" aria-labelledby="home-title">
		<HeroContent
			class="hero-content"
			title={profile.name}
			titleId="home-title"
			titleLines={heroTitleLines}
			titleAriaLabel={profile.name}
			subtitle={home.role}
			summary={home.summary}
			actions={home.actions}
		/>

		<ThemeHeroArt class="hero-art" light={home.heroImages.light} dark={home.heroImages.dark} />
	</section>

	<section class="section" aria-labelledby="featured-projects-title">
		<div class="section-heading split">
			<div>
				<h2 id="featured-projects-title">Featured Projects</h2>
			</div>
			<a class="text-link" href="/projects/">See all projects</a>
		</div>
		<div class="project-grid">
			{
				featuredProjects.map((project) => {
					const company = companyById.get(project.companyId);
					const picture = project.pictures[0];
					const tagGroups = getProjectTagRenderGroups(project.projectTags);
					const hasAwards = project.awards.length > 0;

					return (
						<article class:list={['project-card-shell', hasAwards && 'project-card-shell-awarded']}>
							{hasAwards && <AwardMedals awards={project.awards} ariaLabel={`${project.product} awards`} class="project-card-awards" />}
							<a class="project-card" href={`${projects.href}#${project.id}`} aria-label={`View ${project.product} in projects`}>
								<ProjectImageFrame class="project-image" src={picture.src} alt={picture.alt} loading="lazy">
									{company && <CompanyBadge icon={company.icon} class="project-card-company-badge" />}
								</ProjectImageFrame>
								<div class="project-body">
									<div class="project-company">
										{company && (
											<img
												class={getCompanyLogoToneClass(company.icon)}
												src={company.icon.src}
												alt=""
												loading="lazy"
												{...getImageAttrs(company.icon)}
											/>
										)}
										<span>{company?.name}</span>
									</div>
									<h3>{project.product}</h3>
									<p>{project.description}</p>
									<ProjectTagList tagGroups={tagGroups} ariaLabel={`${project.product} tags`} />
								</div>
							</a>
						</article>
					);
				})
			}
		</div>
	</section>
</BaseLayout>
