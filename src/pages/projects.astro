---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowButton from '../components/ArrowButton.astro';
import AwardMedals from '../components/AwardMedals.astro';
import ButtonLink from '../components/ButtonLink.astro';
import PortfolioWheelCard from '../components/PortfolioWheelCard.astro';
import ProjectImageFrame from '../components/ProjectImageFrame.astro';
import { profile, type Project } from '../data/profile';
import { getProjectActionLinks } from '../data/projectActions';
import { getProjectTagRenderGroups, getProjectTagStyleVars } from '../data/projectTags';
import { getInitialWheelSlot } from '../utils/wheelSlots';

const { home, projects, companies, experience } = profile;
const companyById = new Map(companies.map((company) => [company.id, company]));
const experienceByCompanyId = new Map<string, (typeof experience.items)[number]>();
for (const item of [...experience.items].sort((itemA, itemB) => itemB.sortDate.localeCompare(itemA.sortDate))) {
	if (item.companyId && !experienceByCompanyId.has(item.companyId)) {
		experienceByCompanyId.set(item.companyId, item);
	}
}
const boostedProjectIds = new Set<string>(home.featuredProjectIds);
const boostedProjects = home.featuredProjectIds
	.map((projectId) => projects.items.find((project) => project.id === projectId))
	.filter((project): project is Project => Boolean(project));
const remainingProjects = projects.items
	.filter((project) => !boostedProjectIds.has(project.id))
	.sort((projectA, projectB) => projectB.sortDate.localeCompare(projectA.sortDate));
const wheelProjects = [...boostedProjects, ...remainingProjects];
const releaseStageLabels: Record<Project['releaseStage'], 'In Dev' | 'Released' | 'Shelved' | 'Contributed'> = {
	dev: 'In Dev',
	released: 'Released',
	shelved: 'Shelved',
	contributed: 'Contributed',
};
const initialActiveProjectIndex = 0;
const initialTransitionSlotRange = 3;
---

<BaseLayout
	title={projects.title}
	description={projects.description}
>
	<section class="page-hero projects-hero" aria-labelledby="projects-title">
		<h1 id="projects-title">{projects.hero.title}</h1>
	</section>

	<section class="section project-showcase" id="project-showcase" aria-label="Project selector">
		<div
			class="project-wheel"
			data-project-wheel
			data-wheel-controller
			data-wheel-card-selector="[data-project-card]"
			data-wheel-detail-selector="[data-project-detail-item]"
			data-wheel-index-attr="data-project-index"
			data-wheel-id-attr="data-project-id"
			data-wheel-change-event="project-detail-change"
			data-wheel-initializing="true"
			data-active-index={initialActiveProjectIndex}
			role="group"
			aria-label="Project selector"
		>
			<ArrowButton class="project-wheel-nav project-wheel-nav-prev" direction="prev" ariaLabel="Previous project" data-wheel-prev="" />

			<div class="project-wheel-viewport">
				{
					wheelProjects.map((project, index) => {
						const company = companyById.get(project.companyId);
						const picture = project.pictures[0];
						const releaseStageLabel = releaseStageLabels[project.releaseStage];
						const isActive = index === initialActiveProjectIndex;
						const initialSlot = getInitialWheelSlot(index, wheelProjects.length, initialActiveProjectIndex, initialTransitionSlotRange);

						return (
							<PortfolioWheelCard
								title={project.product}
								subtitle={project.yearLabel}
								media={picture}
								badge={company ? { icon: company.icon } : undefined}
								status={{ label: releaseStageLabel, value: project.releaseStage }}
								ariaLabel={`Select ${project.product}`}
								isActive={isActive}
								initialSlot={initialSlot}
								dataAttrs={{
									'data-project-card': '',
									'data-project-index': index,
									'data-project-id': project.id,
								}}
							/>
						);
					})
				}
			</div>

			<ArrowButton class="project-wheel-nav project-wheel-nav-next" direction="next" ariaLabel="Next project" data-wheel-next="" />
		</div>

		<img class="project-wheel-chest" src="/assets/images/project-chest.webp" alt="" loading="lazy" aria-hidden="true" />

		<div class="project-detail-panel" data-project-detail aria-live="polite">
			{
				wheelProjects.map((project, index) => {
					const company = companyById.get(project.companyId);
					const companyExperience = experienceByCompanyId.get(project.companyId);
					const companyExperienceHref = companyExperience ? `/experience/#${encodeURIComponent(companyExperience.id)}` : undefined;
					const releaseStageLabel = releaseStageLabels[project.releaseStage];
					const hasMultiplePictures = project.pictures.length > 1;
					const actionLinks = getProjectActionLinks(project.actions);
					const tagGroups = getProjectTagRenderGroups(project.projectTags);

					return (
						<article
							class="project-detail"
							id={`project-detail-${project.id}`}
							data-project-detail-item
							data-project-index={index}
							hidden={index === 0 ? undefined : true}
						>
							<AwardMedals awards={project.awards} ariaLabel={`${project.product} awards`} />
							<div class="project-detail-media">
								<div
									class="project-detail-gallery"
									data-project-gallery
									data-gallery-index="0"
									role="group"
									aria-label={`${project.product} images`}
								>
									{project.pictures.map((picture, pictureIndex) => (
										<ProjectImageFrame
											class="project-detail-gallery-image"
											src={picture.src}
											alt={picture.alt}
											loading={index === 0 && pictureIndex === 0 ? 'eager' : 'lazy'}
											data-gallery-image
											data-gallery-image-index={pictureIndex}
											data-gallery-state={pictureIndex === 0 ? 'active' : undefined}
											aria-hidden={pictureIndex === 0 ? 'false' : 'true'}
										/>
									))}
									{hasMultiplePictures && (
										<>
											<ArrowButton
												class="project-detail-gallery-control project-detail-gallery-control-prev"
												direction="prev"
												data-gallery-step="-1"
												ariaLabel={`Show previous ${project.product} image`}
											/>
											<ArrowButton
												class="project-detail-gallery-control project-detail-gallery-control-next"
												direction="next"
												data-gallery-step="1"
												ariaLabel={`Show next ${project.product} image`}
											/>
											<div class="project-detail-gallery-dots" role="group" aria-label={`${project.product} image selector`}>
												{project.pictures.map((_, pictureIndex) => (
													<button
														class="project-detail-gallery-dot"
														type="button"
														data-gallery-dot
														data-gallery-dot-index={pictureIndex}
														aria-label={`Show ${project.product} image ${pictureIndex + 1} of ${project.pictures.length}`}
														aria-current={pictureIndex === 0 ? 'true' : undefined}
													></button>
												))}
											</div>
										</>
									)}
								</div>
							</div>
							<div class="project-detail-content">
								<div class="project-detail-kicker project-detail-topline">
									<span class="project-detail-status" data-status={project.releaseStage}>{releaseStageLabel}</span>
								</div>
								<h3>{project.product}</h3>
								<div class="project-detail-meta">
									{company && (
										companyExperienceHref ? (
											<a class="project-detail-company project-detail-company-link" href={companyExperienceHref} aria-label={`View ${company.name} experience`}>
												<img src={company.icon.src} alt="" loading="lazy" />
												<span>{company.name}</span>
											</a>
										) : (
											<span class="project-detail-company">
												<img src={company.icon.src} alt="" loading="lazy" />
												<span>{company.name}</span>
											</span>
										)
									)}
									<span>{project.dateLabel}</span>
								</div>
								<p class="project-detail-description">{project.description}</p>
								<div class="project-tag-list" aria-label={`${project.product} tags`}>
									{tagGroups.map((tagGroup) => (
										<span class="project-tag-group" data-tag-group={tagGroup.group}>
											{tagGroup.tags.map((tag) => (
												<span class="project-tag" style={getProjectTagStyleVars(tag.style)}>{tag.label}</span>
											))}
										</span>
									))}
								</div>
								{actionLinks.length > 0 && (
									<div class="project-detail-actions">
										{actionLinks.map((action) => (
											<ButtonLink
												href={action.href}
												label={action.label}
												icon={action.icon}
												variant={action.variant}
											/>
										))}
									</div>
								)}
							</div>
						</article>
					);
				})
			}
		</div>
	</section>

	<script>
		import { setupDetailGalleries } from '../scripts/detailGallery';
		import { setupWheelControllers } from '../scripts/wheelController';

		setupWheelControllers();
		setupDetailGalleries({
			gallerySelector: '[data-project-gallery]',
			detailChangeEvent: 'project-detail-change',
		});
	</script>
</BaseLayout>
