---
import BaseLayout from '../layouts/BaseLayout.astro';
import AssetIcon from '../components/AssetIcon.astro';
import { profile, type Project } from '../data/profile';

const { home, projects, companies } = profile;
const companyById = new Map(companies.map((company) => [company.id, company]));
const boostedProjectIds = new Set<string>(home.featuredProjectIds);
const boostedProjects = home.featuredProjectIds
	.map((projectId) => projects.items.find((project) => project.id === projectId))
	.filter((project): project is Project => Boolean(project));
const remainingProjects = projects.items
	.filter((project) => !boostedProjectIds.has(project.id))
	.sort((projectA, projectB) => projectB.sortDate.localeCompare(projectA.sortDate));
const wheelProjects = [...boostedProjects, ...remainingProjects];
const releaseStageLabels: Record<Project['releaseStage'], 'Dev' | 'Released' | 'Shelved'> = {
	dev: 'Dev',
	released: 'Released',
	shelved: 'Shelved',
};
const initialActiveProjectIndex = 0;
const initialTransitionSlotRange = 3;
const getInitialWheelSlot = (index: number) => {
	const total = wheelProjects.length;
	const rawOffset = index - initialActiveProjectIndex;
	const forwardOffset = rawOffset + total;
	const backwardOffset = rawOffset - total;
	const slot = [rawOffset, forwardOffset, backwardOffset].reduce((best, offset) =>
		Math.abs(offset) < Math.abs(best) ? offset : best
	);

	return Math.abs(slot) <= initialTransitionSlotRange ? String(slot) : undefined;
};
---

<BaseLayout
	title={projects.title}
	description={projects.description}
>
	<section class="page-hero projects-hero" aria-labelledby="projects-title">
		<h1 id="projects-title">{projects.hero.title}</h1>
	</section>

	<section class="section project-showcase" id="project-showcase" aria-label="Project selector">
		<div
			class="project-wheel"
			data-project-wheel
			data-wheel-initializing="true"
			data-active-index={initialActiveProjectIndex}
			role="group"
			aria-label="Project selector"
		>
			<button class="project-wheel-nav project-wheel-nav-prev" type="button" data-wheel-prev aria-label="Previous project">
				<span aria-hidden="true">&lsaquo;</span>
			</button>

			<div class="project-wheel-viewport">
				{
					wheelProjects.map((project, index) => {
						const company = companyById.get(project.companyId);
						const picture = project.pictures[0];
						const releaseStageLabel = releaseStageLabels[project.releaseStage];
						const isActive = index === initialActiveProjectIndex;
						const initialSlot = getInitialWheelSlot(index);

						return (
							<button
								class="project-wheel-card"
								type="button"
								data-project-card
								data-project-index={index}
								data-project-id={project.id}
								data-slot={initialSlot}
								aria-pressed={isActive ? 'true' : 'false'}
								aria-label={`Select ${project.product}`}
								tabindex={isActive ? undefined : -1}
							>
								<span class="project-wheel-media">
									<img class="project-wheel-image" src={picture.src} alt={picture.alt} loading={isActive ? 'eager' : 'lazy'} />
									{company && (
										<span class="project-wheel-company-badge" aria-hidden="true">
											<img src={company.icon.src} alt="" loading="lazy" />
										</span>
									)}
									<span class="project-wheel-status-ribbon" data-status={project.releaseStage}>{releaseStageLabel}</span>
								</span>
								<span class="project-wheel-body">
									<span class="project-wheel-title">{project.product}</span>
									<span class="project-wheel-year">{project.yearLabel}</span>
								</span>
							</button>
						);
					})
				}
			</div>

			<button class="project-wheel-nav project-wheel-nav-next" type="button" data-wheel-next aria-label="Next project">
				<span aria-hidden="true">&rsaquo;</span>
			</button>
		</div>

		<img class="project-wheel-chest" src="/assets/images/project-chest.webp" alt="" width="672" height="602" loading="lazy" aria-hidden="true" />

		<div class="project-detail-panel" data-project-detail aria-live="polite">
			{
				wheelProjects.map((project, index) => {
					const company = companyById.get(project.companyId);
					const picture = project.pictures[0];
					const releaseStageLabel = releaseStageLabels[project.releaseStage];

					return (
						<article
							class="project-detail"
							id={project.id}
							data-project-detail-item
							data-project-index={index}
							hidden={index === 0 ? undefined : true}
						>
							<div class="project-detail-media">
								<img src={picture.src} alt={picture.alt} loading={index === 0 ? 'eager' : 'lazy'} />
							</div>
							<div class="project-detail-content">
								<div class="project-detail-kicker">
									<span>{releaseStageLabel}</span>
								</div>
								<h3>{project.product}</h3>
								<div class="project-detail-meta">
									{company && (
										<span class="project-detail-company">
											<img src={company.icon.src} alt="" loading="lazy" />
											<span>{company.name}</span>
										</span>
									)}
									<span>{project.dateLabel}</span>
								</div>
								<p class="project-detail-description">{project.description}</p>
								<div class="tool-list" aria-label={`${project.product} tools`}>
									{project.tools.map((tool) => <span>{tool}</span>)}
								</div>
								<div class="project-awards" aria-label={`${project.product} awards`}>
									<p class="project-awards-title">Awards</p>
									{
										project.awards.length > 0 ? (
											project.awards.map((award) => (
												<div class="project-award">
													<img src={award.emblem.src} alt={award.emblem.alt} loading="lazy" />
													<span>
														<strong>{award.name}</strong>
														<small>{award.awardedFrom}</small>
													</span>
												</div>
											))
										) : (
											<p class="project-awards-empty">No awards recorded yet.</p>
										)
									}
								</div>
								<div class="project-detail-actions">
									<a class="button" href={project.projectUrl ?? `#${project.id}`}>
										<AssetIcon src="/assets/icons/gamepad.svg" class="button-icon" />
										View Project
									</a>
									{project.sourceUrl && (
										<a class="button button-2" href={project.sourceUrl}>
											<AssetIcon src="/assets/icons/github.svg" class="button-icon" />
											Source Code
										</a>
									)}
								</div>
							</div>
						</article>
					);
				})
			}
		</div>
	</section>

	<script is:inline>
		(() => {
			const wheel = document.querySelector('[data-project-wheel]');
			const cards = Array.from(document.querySelectorAll('[data-project-card]'));
			const details = Array.from(document.querySelectorAll('[data-project-detail-item]'));
			const previousButton = document.querySelector('[data-wheel-prev]');
			const nextButton = document.querySelector('[data-wheel-next]');

			if (!wheel || cards.length === 0) {
				return;
			}

			const total = cards.length;
			let activeIndex = Number(wheel.getAttribute('data-active-index')) || 0;
			const desktopQuery = window.matchMedia('(min-width: 821px)');
			const phoneQuery = window.matchMedia('(max-width: 460px)');

			const getSlotRanges = () => {
				if (phoneQuery.matches) {
					return {
						interactive: 0,
						transition: 1,
					};
				}

				return desktopQuery.matches
					? {
							interactive: 2,
							transition: 3,
						}
					: {
							interactive: 1,
							transition: 2,
						};
			};

			const wrapIndex = (index) => ((index % total) + total) % total;
			const shortestOffset = (index, active) => {
				const rawOffset = index - active;
				const forwardOffset = rawOffset + total;
				const backwardOffset = rawOffset - total;

				return [rawOffset, forwardOffset, backwardOffset].reduce((best, offset) =>
					Math.abs(offset) < Math.abs(best) ? offset : best
				);
			};

			const updateWheel = () => {
				const { interactive, transition } = getSlotRanges();

				wheel.setAttribute('data-active-index', String(activeIndex));

				cards.forEach((card) => {
					const projectIndex = Number(card.getAttribute('data-project-index'));
					const slot = shortestOffset(projectIndex, activeIndex);
					const slotDistance = Math.abs(slot);
					const transitionSlot = slotDistance <= transition ? String(slot) : '';
					const isInteractive = slotDistance <= interactive;
					const isActive = projectIndex === activeIndex;

					if (transitionSlot) {
						card.setAttribute('data-slot', transitionSlot);
					} else {
						card.removeAttribute('data-slot');
					}

					card.setAttribute('aria-pressed', String(isActive));
					card.setAttribute('aria-hidden', String(!isInteractive));
					card.tabIndex = isInteractive ? 0 : -1;
				});

				details.forEach((detail) => {
					const projectIndex = Number(detail.getAttribute('data-project-index'));
					detail.hidden = projectIndex !== activeIndex;
				});
			};

			const setActiveIndex = (index) => {
				activeIndex = wrapIndex(index);
				updateWheel();
			};

			cards.forEach((card) => {
				card.addEventListener('click', () => {
					setActiveIndex(Number(card.getAttribute('data-project-index')));
				});

				card.addEventListener('keydown', (event) => {
					if (event.key === 'ArrowLeft') {
						event.preventDefault();
						setActiveIndex(activeIndex - 1);
					}

					if (event.key === 'ArrowRight') {
						event.preventDefault();
						setActiveIndex(activeIndex + 1);
					}
				});
			});

			previousButton?.addEventListener('click', () => setActiveIndex(activeIndex - 1));
			nextButton?.addEventListener('click', () => setActiveIndex(activeIndex + 1));
			desktopQuery.addEventListener('change', updateWheel);
			phoneQuery.addEventListener('change', updateWheel);

			updateWheel();

			const enableWheelTransitions = () => {
				wheel.removeAttribute('data-wheel-initializing');
			};

			if (!('requestAnimationFrame' in window)) {
				window.setTimeout(enableWheelTransitions, 0);
				return;
			}

			window.requestAnimationFrame(() => {
				window.requestAnimationFrame(enableWheelTransitions);
			});
		})();
	</script>
</BaseLayout>
