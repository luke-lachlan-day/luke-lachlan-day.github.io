---
import BaseLayout from '../layouts/BaseLayout.astro';
import AssetIcon from '../components/AssetIcon.astro';
import ProjectImageFrame from '../components/ProjectImageFrame.astro';
import { profile, type Project } from '../data/profile';
import { getProjectActionLinks } from '../data/projectActions';
import { getProjectTagRenderGroups, getProjectTagStyleVars } from '../data/projectTags';

const { home, projects, companies } = profile;
const companyById = new Map(companies.map((company) => [company.id, company]));
const boostedProjectIds = new Set<string>(home.featuredProjectIds);
const boostedProjects = home.featuredProjectIds
	.map((projectId) => projects.items.find((project) => project.id === projectId))
	.filter((project): project is Project => Boolean(project));
const remainingProjects = projects.items
	.filter((project) => !boostedProjectIds.has(project.id))
	.sort((projectA, projectB) => projectB.sortDate.localeCompare(projectA.sortDate));
const wheelProjects = [...boostedProjects, ...remainingProjects];
const releaseStageLabels: Record<Project['releaseStage'], 'In Dev' | 'Released' | 'Shelved' | 'Contributed'> = {
	dev: 'In Dev',
	released: 'Released',
	shelved: 'Shelved',
	contributed: 'Contributed',
};
const isExternalLink = (href: string) => href.startsWith('http://') || href.startsWith('https://');
const initialActiveProjectIndex = 0;
const initialTransitionSlotRange = 3;
const getInitialWheelSlot = (index: number) => {
	const total = wheelProjects.length;
	const rawOffset = index - initialActiveProjectIndex;
	const forwardOffset = rawOffset + total;
	const backwardOffset = rawOffset - total;
	const slot = [rawOffset, forwardOffset, backwardOffset].reduce((best, offset) =>
		Math.abs(offset) < Math.abs(best) ? offset : best
	);

	return Math.abs(slot) <= initialTransitionSlotRange ? String(slot) : undefined;
};
---

<BaseLayout
	title={projects.title}
	description={projects.description}
>
	<section class="page-hero projects-hero" aria-labelledby="projects-title">
		<h1 id="projects-title">{projects.hero.title}</h1>
	</section>

	<section class="section project-showcase" id="project-showcase" aria-label="Project selector">
		<div
			class="project-wheel"
			data-project-wheel
			data-wheel-initializing="true"
			data-active-index={initialActiveProjectIndex}
			role="group"
			aria-label="Project selector"
		>
			<button class="project-wheel-nav project-wheel-nav-prev" type="button" data-wheel-prev aria-label="Previous project">
				<span aria-hidden="true">&lsaquo;</span>
			</button>

			<div class="project-wheel-viewport">
				{
					wheelProjects.map((project, index) => {
						const company = companyById.get(project.companyId);
						const picture = project.pictures[0];
						const releaseStageLabel = releaseStageLabels[project.releaseStage];
						const isActive = index === initialActiveProjectIndex;
						const initialSlot = getInitialWheelSlot(index);

						return (
							<button
								class="project-wheel-card"
								type="button"
								data-project-card
								data-project-index={index}
								data-project-id={project.id}
								data-slot={initialSlot}
								aria-pressed={isActive ? 'true' : 'false'}
								aria-label={`Select ${project.product}`}
								tabindex={isActive ? undefined : -1}
							>
								<ProjectImageFrame class="project-wheel-media" src={picture.src} alt={picture.alt} loading={isActive ? 'eager' : 'lazy'}>
									{company && (
										<span class="project-wheel-company-badge" aria-hidden="true">
											<span class="project-wheel-company-badge-back"></span>
											<span class="project-wheel-company-badge-icon" style={`--company-icon-url: url("${company.icon.src}")`}></span>
										</span>
									)}
									<span class="project-wheel-status-ribbon" data-status={project.releaseStage}>{releaseStageLabel}</span>
								</ProjectImageFrame>
								<span class="project-wheel-body">
									<span class="project-wheel-title">{project.product}</span>
									<span class="project-wheel-year">{project.yearLabel}</span>
								</span>
							</button>
						);
					})
				}
			</div>

			<button class="project-wheel-nav project-wheel-nav-next" type="button" data-wheel-next aria-label="Next project">
				<span aria-hidden="true">&rsaquo;</span>
			</button>
		</div>

		<img class="project-wheel-chest" src="/assets/images/project-chest.webp" alt="" loading="lazy" aria-hidden="true" />

		<div class="project-detail-panel" data-project-detail aria-live="polite">
			{
				wheelProjects.map((project, index) => {
					const company = companyById.get(project.companyId);
					const releaseStageLabel = releaseStageLabels[project.releaseStage];
					const hasMultiplePictures = project.pictures.length > 1;
					const actionLinks = getProjectActionLinks(project.actions);
					const tagGroups = getProjectTagRenderGroups(project.projectTags);

					return (
						<article
							class="project-detail"
							id={`project-detail-${project.id}`}
							data-project-detail-item
							data-project-index={index}
							hidden={index === 0 ? undefined : true}
						>
							<div class="project-detail-media">
								<div
									class="project-detail-gallery"
									data-project-gallery
									data-gallery-index="0"
									role="group"
									aria-label={`${project.product} images`}
								>
									{project.pictures.map((picture, pictureIndex) => (
										<ProjectImageFrame
											class="project-detail-gallery-image"
											src={picture.src}
											alt={picture.alt}
											loading={index === 0 && pictureIndex === 0 ? 'eager' : 'lazy'}
											data-gallery-image
											data-gallery-image-index={pictureIndex}
											data-gallery-state={pictureIndex === 0 ? 'active' : undefined}
											aria-hidden={pictureIndex === 0 ? 'false' : 'true'}
										/>
									))}
									{hasMultiplePictures && (
										<>
											<button
												class="project-detail-gallery-control project-detail-gallery-control-prev"
												type="button"
												data-gallery-step="-1"
												aria-label={`Show previous ${project.product} image`}
											>
												<span aria-hidden="true">&lsaquo;</span>
											</button>
											<button
												class="project-detail-gallery-control project-detail-gallery-control-next"
												type="button"
												data-gallery-step="1"
												aria-label={`Show next ${project.product} image`}
											>
												<span aria-hidden="true">&rsaquo;</span>
											</button>
											<div class="project-detail-gallery-dots" role="group" aria-label={`${project.product} image selector`}>
												{project.pictures.map((_, pictureIndex) => (
													<button
														class="project-detail-gallery-dot"
														type="button"
														data-gallery-dot
														data-gallery-dot-index={pictureIndex}
														aria-label={`Show ${project.product} image ${pictureIndex + 1} of ${project.pictures.length}`}
														aria-current={pictureIndex === 0 ? 'true' : undefined}
													></button>
												))}
											</div>
										</>
									)}
								</div>
							</div>
							<div class="project-detail-content">
								<div class="project-detail-kicker">
									<span data-status={project.releaseStage}>{releaseStageLabel}</span>
									{
										project.awards.length > 0 && (
											<div class="project-awards project-awards-compact" aria-label={`${project.product} awards`}>
												<div class="project-award-list">
													{project.awards.map((award) => (
														<span
															class="project-award"
															role="img"
															tabindex="0"
															aria-label={`${award.year} ${award.name}, awarded by ${award.awardedFrom}`}
														>
															<span
																class="project-award-emblem"
																style={`--award-emblem-url: url("${award.emblem.src}")`}
																aria-hidden="true"
															></span>
															<span class="project-award-details" aria-hidden="true">
																<strong>{award.name}</strong>
																<span>{award.awardedFrom}</span>
																<small>{award.year}</small>
															</span>
														</span>
													))}
												</div>
											</div>
										)
									}
								</div>
								<h3>{project.product}</h3>
								<div class="project-detail-meta">
									{company && (
										<span class="project-detail-company">
											<img src={company.icon.src} alt="" loading="lazy" />
											<span>{company.name}</span>
										</span>
									)}
									<span>{project.dateLabel}</span>
								</div>
								<p class="project-detail-description">{project.description}</p>
								<div class="project-tag-list" aria-label={`${project.product} tags`}>
									{tagGroups.map((tagGroup) => (
										<span class="project-tag-group" data-tag-group={tagGroup.group}>
											{tagGroup.tags.map((tag) => (
												<span class="project-tag" style={getProjectTagStyleVars(tag.style)}>{tag.label}</span>
											))}
										</span>
									))}
								</div>
								{actionLinks.length > 0 && (
									<div class="project-detail-actions">
										{actionLinks.map((action, actionIndex) => (
											<a
												class:list={['button', actionIndex > 0 && 'button-2']}
												href={action.href}
												target={isExternalLink(action.href) ? '_blank' : undefined}
												rel={isExternalLink(action.href) ? 'noreferrer' : undefined}
											>
												<AssetIcon src={action.icon} class="button-icon" />
												{action.label}
											</a>
										))}
									</div>
								)}
							</div>
						</article>
					);
				})
			}
		</div>
	</section>

	<script is:inline>
		(() => {
			const wheel = document.querySelector('[data-project-wheel]');
			const cards = Array.from(document.querySelectorAll('[data-project-card]'));
			const details = Array.from(document.querySelectorAll('[data-project-detail-item]'));
			const previousButton = document.querySelector('[data-wheel-prev]');
			const nextButton = document.querySelector('[data-wheel-next]');

			if (!wheel || cards.length === 0) {
				return;
			}

			const total = cards.length;
			let activeIndex = Number(wheel.getAttribute('data-active-index')) || 0;
			const desktopQuery = window.matchMedia('(min-width: 821px)');
			const phoneQuery = window.matchMedia('(max-width: 460px)');
			const projectHashPrefix = '#';

			const getSlotRanges = () => {
				if (phoneQuery.matches) {
					return {
						interactive: 0,
						transition: 1,
					};
				}

				return desktopQuery.matches
					? {
							interactive: 2,
							transition: 3,
						}
					: {
							interactive: 1,
							transition: 2,
						};
			};

			const wrapIndex = (index) => ((index % total) + total) % total;
			const getProjectIdFromHash = () => {
				const hash = window.location.hash.slice(projectHashPrefix.length);

				if (!hash) {
					return '';
				}

				try {
					return decodeURIComponent(hash);
				} catch {
					return hash;
				}
			};
			const shortestOffset = (index, active) => {
				const rawOffset = index - active;
				const forwardOffset = rawOffset + total;
				const backwardOffset = rawOffset - total;

				return [rawOffset, forwardOffset, backwardOffset].reduce((best, offset) =>
					Math.abs(offset) < Math.abs(best) ? offset : best
				);
			};

			const updateWheel = () => {
				const { interactive, transition } = getSlotRanges();

				wheel.setAttribute('data-active-index', String(activeIndex));

				cards.forEach((card) => {
					const projectIndex = Number(card.getAttribute('data-project-index'));
					const slot = shortestOffset(projectIndex, activeIndex);
					const slotDistance = Math.abs(slot);
					const transitionSlot = slotDistance <= transition ? String(slot) : '';
					const isInteractive = slotDistance <= interactive;
					const isActive = projectIndex === activeIndex;

					if (transitionSlot) {
						card.setAttribute('data-slot', transitionSlot);
					} else {
						card.removeAttribute('data-slot');
					}

					card.setAttribute('aria-pressed', String(isActive));
					card.setAttribute('aria-hidden', String(!isInteractive));
					card.tabIndex = isInteractive ? 0 : -1;
				});

				details.forEach((detail) => {
					const projectIndex = Number(detail.getAttribute('data-project-index'));
					detail.hidden = projectIndex !== activeIndex;
				});

				window.dispatchEvent(new CustomEvent('project-detail-change', { detail: { activeIndex } }));
			};

			const setActiveIndex = (index, updateHash = false) => {
				activeIndex = wrapIndex(index);
				updateWheel();

				if (!updateHash) {
					return;
				}

				const activeCard = cards[activeIndex];
				const projectId = activeCard?.getAttribute('data-project-id');

				if (!projectId) {
					return;
				}

				const nextHash = `${projectHashPrefix}${encodeURIComponent(projectId)}`;
				if (window.location.hash !== nextHash) {
					window.history.replaceState(null, '', nextHash);
				}
			};
			const setActiveProjectFromHash = () => {
				const projectId = getProjectIdFromHash();

				if (!projectId) {
					return;
				}

				const matchingCard = cards.find((card) => card.getAttribute('data-project-id') === projectId);

				if (!matchingCard) {
					return;
				}

				setActiveIndex(Number(matchingCard.getAttribute('data-project-index')));
			};

			cards.forEach((card) => {
				card.addEventListener('click', () => {
					setActiveIndex(Number(card.getAttribute('data-project-index')), true);
				});

				card.addEventListener('keydown', (event) => {
					if (event.key === 'ArrowLeft') {
						event.preventDefault();
						setActiveIndex(activeIndex - 1);
					}

					if (event.key === 'ArrowRight') {
						event.preventDefault();
						setActiveIndex(activeIndex + 1);
					}
				});
			});

			previousButton?.addEventListener('click', () => setActiveIndex(activeIndex - 1));
			nextButton?.addEventListener('click', () => setActiveIndex(activeIndex + 1));
			desktopQuery.addEventListener('change', updateWheel);
			phoneQuery.addEventListener('change', updateWheel);
			window.addEventListener('hashchange', setActiveProjectFromHash);

			setActiveProjectFromHash();
			updateWheel();

			const enableWheelTransitions = () => {
				wheel.removeAttribute('data-wheel-initializing');
			};

			if (!('requestAnimationFrame' in window)) {
				window.setTimeout(enableWheelTransitions, 0);
				return;
			}

			window.requestAnimationFrame(() => {
				window.requestAnimationFrame(enableWheelTransitions);
			});
		})();
	</script>
	<script is:inline>
		(() => {
			const galleryTiming = {
				idleMs: 10000,
				intervalMs: 4000,
				transitionMs: 900,
			};
			const galleries = Array.from(document.querySelectorAll('[data-project-gallery]'));
			const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

			galleries.forEach((gallery) => {
				const detail = gallery.closest('[data-project-detail-item]');
				const images = Array.from(gallery.querySelectorAll('[data-gallery-image]'));
				const controls = Array.from(gallery.querySelectorAll('[data-gallery-step]'));
				const dots = Array.from(gallery.querySelectorAll('[data-gallery-dot]'));

				if (images.length <= 1) {
					return;
				}

				gallery.style.setProperty('--project-gallery-transition-ms', `${galleryTiming.transitionMs}ms`);

				let idleTimer = 0;
				let intervalTimer = 0;
				let transitionTimer = 0;
				let isHovered = false;
				let hasFocus = gallery.contains(document.activeElement);
				let prefersReducedMotion = reducedMotionQuery.matches;
				let isProjectHidden = detail?.hidden ?? false;

				const wrapIndex = (index) => ((index % images.length) + images.length) % images.length;
				const setGalleryIndex = (nextIndex) => {
					const previousIndex = Number(gallery.getAttribute('data-gallery-index')) || 0;
					const activeIndex = wrapIndex(nextIndex);
					gallery.setAttribute('data-gallery-index', String(activeIndex));
					window.clearTimeout(transitionTimer);

					images.forEach((image) => {
						const imageIndex = Number(image.getAttribute('data-gallery-image-index'));
						const isActive = imageIndex === activeIndex;
						const isExiting = !prefersReducedMotion && previousIndex !== activeIndex && imageIndex === previousIndex;

						if (isActive) {
							image.setAttribute('data-gallery-state', 'active');
						} else if (isExiting) {
							image.setAttribute('data-gallery-state', 'exiting');
						} else {
							image.removeAttribute('data-gallery-state');
						}

						image.setAttribute('aria-hidden', String(!isActive));
					});

					dots.forEach((dot) => {
						const dotIndex = Number(dot.getAttribute('data-gallery-dot-index'));
						const isActive = dotIndex === activeIndex;

						if (isActive) {
							dot.setAttribute('aria-current', 'true');
						} else {
							dot.removeAttribute('aria-current');
						}
					});

					if (!prefersReducedMotion && previousIndex !== activeIndex) {
						transitionTimer = window.setTimeout(() => {
							images.forEach((image) => {
								if (image.getAttribute('data-gallery-state') === 'exiting') {
									image.removeAttribute('data-gallery-state');
								}
							});
						}, galleryTiming.transitionMs);
					}
				};
				const clearTimers = () => {
					window.clearTimeout(idleTimer);
					window.clearInterval(intervalTimer);
					idleTimer = 0;
					intervalTimer = 0;
				};
				const isPaused = () => isHovered || hasFocus || prefersReducedMotion || isProjectHidden;
				const startInterval = () => {
					clearTimers();

					if (isPaused()) {
						return;
					}

					intervalTimer = window.setInterval(() => {
						const currentIndex = Number(gallery.getAttribute('data-gallery-index')) || 0;
						setGalleryIndex(currentIndex + 1);
					}, galleryTiming.intervalMs);
				};
				const scheduleIdleAdvance = () => {
					clearTimers();

					if (isPaused()) {
						return;
					}

					idleTimer = window.setTimeout(() => {
						const currentIndex = Number(gallery.getAttribute('data-gallery-index')) || 0;
						setGalleryIndex(currentIndex + 1);
						startInterval();
					}, galleryTiming.idleMs);
				};
				const resetAutoplay = () => {
					clearTimers();
					scheduleIdleAdvance();
				};
				const navigateManually = (nextIndex) => {
					setGalleryIndex(nextIndex);
					resetAutoplay();
				};

				controls.forEach((control) => {
					control.addEventListener('click', () => {
						const currentIndex = Number(gallery.getAttribute('data-gallery-index')) || 0;
						const step = Number(control.getAttribute('data-gallery-step')) || 0;
						navigateManually(currentIndex + step);
					});
				});

				dots.forEach((dot) => {
					dot.addEventListener('click', () => {
						navigateManually(Number(dot.getAttribute('data-gallery-dot-index')) || 0);
					});
				});

				gallery.addEventListener('mouseenter', () => {
					isHovered = true;
					clearTimers();
				});

				gallery.addEventListener('mouseleave', () => {
					isHovered = false;
					resetAutoplay();
				});

				gallery.addEventListener('focusin', () => {
					hasFocus = true;
					clearTimers();
				});

				gallery.addEventListener('focusout', () => {
					window.setTimeout(() => {
						hasFocus = gallery.contains(document.activeElement);

						if (!hasFocus) {
							resetAutoplay();
						}
					}, 0);
				});

				reducedMotionQuery.addEventListener('change', () => {
					prefersReducedMotion = reducedMotionQuery.matches;
					setGalleryIndex(Number(gallery.getAttribute('data-gallery-index')) || 0);
					resetAutoplay();
				});

				window.addEventListener('project-detail-change', () => {
					isProjectHidden = detail?.hidden ?? false;
					resetAutoplay();
				});

				setGalleryIndex(0);
				scheduleIdleAdvance();
			});
		})();
	</script>
</BaseLayout>
