---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/showcase.css';
import ButtonLink from '../components/ButtonLink.astro';
import DetailGallery from '../components/DetailGallery.astro';
import PortfolioWheelCard from '../components/PortfolioWheelCard.astro';
import ProjectTagList from '../components/ProjectTagList.astro';
import ShowcaseDetail from '../components/ShowcaseDetail.astro';
import ShowcaseWheel from '../components/ShowcaseWheel.astro';
import { profile } from '../data/profile';
import { getProjectShowcaseItems } from '../data/projectShowcase';
import { getCompanyLogoToneClass } from '../utils/companyLogoTone';
import { getImageAttrs } from '../utils/images';
import { getInitialWheelSlot } from '../utils/wheelSlots';

const { projects, companies, experience } = profile;
const showcaseItems = getProjectShowcaseItems({
	projects: projects.items,
	companies,
	experienceItems: experience.items,
});
const initialActiveProjectIndex = 0;
const initialTransitionSlotRange = 3;
const getProjectDetailSectionId = (projectId: string, sectionTitle: string) =>
	`project-detail-${projectId}-${sectionTitle
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-|-$/g, '')}`;
---

<BaseLayout title={projects.title} description={projects.description}>
	<section class="page-hero projects-hero" aria-labelledby="projects-title">
		<h1 id="projects-title">{projects.hero.title}</h1>
	</section>

	<section class="section project-showcase" id="project-showcase" aria-labelledby="project-selector-title">
		<h2 id="project-selector-title" class="visually-hidden">Project selector</h2>
		<ShowcaseWheel
			labelledBy="project-selector-title"
			previousLabel="Previous project"
			nextLabel="Next project"
			activeIndex={initialActiveProjectIndex}
			dataAttrs={{ 'data-project-wheel': '' }}
		>
			{
				showcaseItems.map(({ project, company, primaryPicture, releaseStageLabel }, index) => {
					const isActive = index === initialActiveProjectIndex;
					const initialSlot = getInitialWheelSlot(index, showcaseItems.length, initialActiveProjectIndex, initialTransitionSlotRange);

					return (
						<PortfolioWheelCard
							title={project.product}
							subtitle={project.yearLabel}
							media={primaryPicture}
							badge={company ? { icon: company.icon } : undefined}
							status={{ label: releaseStageLabel, value: project.releaseStage }}
							ariaLabel={`Select ${project.product}`}
							isActive={isActive}
							initialSlot={initialSlot}
							fallbackClass="showcase-wheel-media-fallback"
							fallbackLabel={project.product.slice(0, 1)}
							dataAttrs={{
								'data-project-card': '',
								'data-project-index': index,
								'data-project-id': project.id,
							}}
						/>
					);
				})
			}
		</ShowcaseWheel>

		<img
			class="project-wheel-chest"
			src="/assets/images/project-chest.webp"
			alt=""
			loading="lazy"
			{...getImageAttrs('/assets/images/project-chest.webp')}
			aria-hidden="true"
		/>

		<div class="project-detail-panel" data-project-detail aria-live="polite">
			{
				showcaseItems.map(({ project, company, companyExperienceHref, releaseStageLabel, actionLinks, tagGroups }, index) => {
					return (
						<ShowcaseDetail
							id={`project-detail-${project.id}`}
							index={index}
							activeIndex={initialActiveProjectIndex}
							itemAttr="data-project-detail-item"
							indexAttr="data-project-index"
							awards={project.awards}
							awardsAriaLabel={`${project.product} awards`}
						>
							<Fragment slot="media">
								{project.pictures.length > 0 ? (
									<DetailGallery
										pictures={project.pictures}
										galleryAttr="data-project-gallery"
										galleryLabel={`${project.product} images`}
										imageLabel={project.product}
										firstImageEager={index === initialActiveProjectIndex}
									/>
								) : (
									<div class="project-detail-gallery" aria-hidden="true" />
								)}
							</Fragment>
							<Fragment slot="content">
								<div class="project-detail-kicker project-detail-topline">
									<span class="project-detail-status" data-status={project.releaseStage}>
										{releaseStageLabel}
									</span>
								</div>
								<h3>{project.product}</h3>
								<div class="project-detail-meta">
									{company &&
										(companyExperienceHref ? (
											<a class="project-detail-company project-detail-company-link" href={companyExperienceHref}>
												<img
													class={getCompanyLogoToneClass(company.icon)}
													src={company.icon.src}
													alt=""
													loading="lazy"
													{...getImageAttrs(company.icon)}
												/>
												<span>{company.name}</span>
												<span class="visually-hidden"> experience</span>
											</a>
										) : (
											<span class="project-detail-company">
												<img
													class={getCompanyLogoToneClass(company.icon)}
													src={company.icon.src}
													alt=""
													loading="lazy"
													{...getImageAttrs(company.icon)}
												/>
												<span>{company.name}</span>
											</span>
										))}
									{project.dateLabel && <span>{project.dateLabel}</span>}
								</div>
								<p class="project-detail-description">{project.description}</p>
								{project.detailSections && project.detailSections.length > 0 && (
									<div class="project-detail-sections" aria-label={`${project.product} details`}>
										{project.detailSections.map((section) => {
											const sectionId = getProjectDetailSectionId(project.id, section.title);

											return (
												<section class="project-detail-section" aria-labelledby={sectionId}>
													<h4 id={sectionId}>{section.title}</h4>
													<ul>
														{section.items.map((item) => (
															<li>{item}</li>
														))}
													</ul>
												</section>
											);
										})}
									</div>
								)}
								{project.mediaNotice && <p class="project-detail-media-notice">{project.mediaNotice}</p>}
								<ProjectTagList tagGroups={tagGroups} ariaLabel={`${project.product} tags`} />
								{actionLinks.length > 0 && (
									<div class="project-detail-actions">
										{actionLinks.map((action) => (
											<ButtonLink href={action.href} label={action.label} icon={action.icon} variant={action.variant} />
										))}
									</div>
								)}
							</Fragment>
						</ShowcaseDetail>
					);
				})
			}
		</div>
	</section>

	<script>
		import { setupShowcaseControllers } from '../scripts/showcaseController';

		setupShowcaseControllers({
			wheelSelector: '[data-project-wheel]',
			cardSelector: '[data-project-card]',
			detailSelector: '[data-project-detail-item]',
			indexAttr: 'data-project-index',
			idAttr: 'data-project-id',
			changeEvent: 'project-detail-change',
			detailRootSelector: '#project-showcase',
			gallerySelector: '[data-project-gallery]',
		});
	</script>
</BaseLayout>
