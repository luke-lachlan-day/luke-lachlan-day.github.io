---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';

const { timeline, projects, companies } = profile;
const companyById = new Map(companies.map((company) => [company.id, company]));
---

<BaseLayout
	title={timeline.title}
	description={timeline.description}
>
	<section class="page-hero" aria-labelledby="timeline-title">
		<h1 id="timeline-title">{timeline.hero.title}</h1>
		<p>{timeline.hero.lead}</p>
	</section>

	<section class="section" aria-labelledby="projects-title">
		<div class="section-heading split">
			<div>
				<p class="eyebrow">{projects.eyebrow}</p>
				<h2 id="projects-title">{projects.title}</h2>
			</div>
			<p>{projects.copy}</p>
		</div>

		<div class="project-grid">
			{
				projects.items.map((project) => {
					const company = companyById.get(project.companyId);
					const picture = project.pictures[0];

					return (
						<article class="project-card">
							<img class="project-image" src={picture.src} alt={picture.alt} loading="lazy" />
							<div class="project-body">
								<div class="project-company">
									{company && <img src={company.icon.src} alt="" loading="lazy" />}
									<span>{company?.name}</span>
								</div>
								<h3>{project.product}</h3>
								<p>{project.description}</p>
								<div class="tool-list" aria-label={`${project.product} tools`}>
									{project.tools.map((tool) => <span>{tool}</span>)}
								</div>
							</div>
						</article>
					);
				})
			}
		</div>
	</section>

	<section class="section" aria-labelledby="history-title">
		<div class="section-heading">
			<p class="eyebrow">{timeline.history.eyebrow}</p>
			<h2 id="history-title">{timeline.history.title}</h2>
		</div>

		<div class="timeline">
			{
				timeline.items.map((item) => (
					<article class="timeline-item">
						<p class="timeline-date">{item.date}</p>
						<h3>{item.title}</h3>
						<p>{item.copy}</p>
					</article>
				))
			}
		</div>
	</section>
</BaseLayout>
